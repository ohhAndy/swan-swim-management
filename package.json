{
  "packageManager": "npm@10.8.3",
  "name": "swan-swim-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm --prefix packages/db run generate",
    "db:migrate": "npm --prefix packages/db run migrate:dev",
    "db:push": "npm --prefix packages/db run push",
    "db:studio": "npm --prefix packages/db run studio",
    "check-types": "tsc --noEmit",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "turbo": "^2.10.12",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "zod": "^4.3.5"
  }
}
